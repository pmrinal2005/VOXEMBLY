# ============================================================================
# VOXEMBLY — Environment Variables
# Copy this file to `.env.local` (local dev) and set the same keys in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# NEVER commit real keys. `.env.local` is git-ignored.
# ============================================================================

# ---- REQUIRED: AssemblyAI Dictation / Sync STT (the core loop) -------------
# Get it from https://www.assemblyai.com/app  →  API Keys
# Nothing transcribes without this.
ASSEMBLYAI_API_KEY=

# ---- REQUIRED for cleanup + Agent Council ----------------------------------
# Free GroqCloud key: https://console.groq.com/keys
GROQ_API_KEY=

# ---- OPTIONAL: Supabase (persistence). If unset, VOXEMBLY runs in local -----
# in-browser (IndexedDB) demo mode and still fully works for the demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- OPTIONAL: Embeddings (Jina). Falls back to $0 client-side if unset -----
JINA_API_KEY=

# ---- OPTIONAL: Neo4j Aura (temporal graph). Stubbed to Postgres/local if unset
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# ---- OPTIONAL: AssemblyAI region routing (us | eu | global). Default: global
NEXT_PUBLIC_AAI_REGION=global
