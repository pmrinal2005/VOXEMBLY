# ─────────────────────────────────────────────────────────────────────────────
# VOXEMBLY environment
# Copy to .env.local (never commit). Server-only secrets have no NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — AssemblyAI (Sync STT / Dictation, Universal-3.5 Pro). Nothing works without it.
ASSEMBLYAI_API_KEY=

# Optional — force a Sync STT region: global | us | eu  (default: global = nearest region)
ASSEMBLYAI_SYNC_REGION=global

# REQUIRED — GroqCloud (cleanup pass + Agent Council). Free tier, OpenAI-compatible.
GROQ_API_KEY=

# Supabase (Postgres + pgvector + Auth). If omitted, VOXEMBLY runs in Local Twin mode (IndexedDB only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Jina Embeddings v4 (1M tokens/month free). Falls back to in-browser bge-small-en-v1.5 (Transformers.js) when absent or on 429.
JINA_API_KEY=

# Optional — Neo4j Aura Free (temporal graph mirror). Temporal edges are modelled in Postgres/IndexedDB first; Aura is an optional mirror.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Optional — Brave Search API (2,000 queries/month free) for the Researcher agent. Falls back to DuckDuckGo Instant Answers (no key).
BRAVE_SEARCH_API_KEY=

# Optional — SearXNG instance URL (self-hosted on a Hugging Face Space) — used before Brave/DDG when set.
SEARXNG_URL=

# Optional — public origin, used to build shareable /t/{hash} links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
