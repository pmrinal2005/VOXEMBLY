# ============================================================================
# VOXEMBLY — Environment Variables
# Copy to `.env.local` for local Next.js, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.
# NEVER commit real keys.
# ============================================================================

# Postgres (required in this sandbox / any Drizzle deploy)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- REQUIRED for live dictation ------------------------------------------
# https://www.assemblyai.com/app  →  API Keys
# Server-side only. Without it, VOXEMBLY uses labeled simulated transcripts.
ASSEMBLYAI_API_KEY=

# ---- REQUIRED for cleanup + Agent Council ---------------------------------
# Free GroqCloud key: https://console.groq.com/keys
GROQ_API_KEY=

# ---- OPTIONAL: embeddings (Jina). Falls back to a $0 hash embed -----------
# https://jina.ai/embeddings/
JINA_API_KEY=

# ---- OPTIONAL: AssemblyAI region routing (us | eu | global) ---------------
NEXT_PUBLIC_AAI_REGION=global

# ---- OPTIONAL: public site URL used for share links (/t/[hash]) -----------
NEXT_PUBLIC_SITE_URL=

# ---- OPTIONAL: web search for the Researcher agent ------------------------
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
